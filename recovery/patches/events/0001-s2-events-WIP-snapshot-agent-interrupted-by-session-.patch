+import { useState } from 'react';
+import { MARKET_EVENT_INFO, recentMarketEvent } from '../engine/events';
+import type { GameState } from '../engine/types';
+
+// Market event card (experimental rules.marketEvents). Small, non-blocking and dismissible: it
+// shows the last market event for one round after it fired, then hides itself. Styles live in
+// styles/events.css. It floats over the top of a positioned parent (the desktop board column and
+// the mobile board area both are) and renders nothing when events are off.
+
+function TrendGlyph({ up }: { up: boolean }) {
+  return (
+    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" className="market-event-glyph">
+      <polyline
+        points={up ? '1.5,12 6,7.5 9,10 14.5,4' : '1.5,4 6,8.5 9,6 14.5,12'}
+        fill="none"
+        stroke="currentColor"
+        strokeWidth="1.8"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+      <polyline
+        points={up ? '10.5,4 14.5,4 14.5,8' : '10.5,12 14.5,12 14.5,8'}
+        fill="none"
+        stroke="currentColor"
+        strokeWidth="1.8"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  );
+}
+
+export function MarketEventBanner({ state, onDismiss }: { state: GameState; onDismiss?: () => void }) {
+  const [dismissed, setDismissed] = useState<string | null>(null);
+  const event = recentMarketEvent(state);
+  if (!event || state.phase === 'gameOver') return null;
+  // Keyed by game and turn, so the next event (or a new game) shows again after a dismissal.
+  const key = `${state.seed}:${event.turn}`;
+  if (dismissed === key) return null;
+  const info = MARKET_EVENT_INFO[event.type];
+  const blurb = info.blurb.charAt(0).toUpperCase() + info.blurb.slice(1);
+  return (
+    <aside className={`market-event ${info.tone}`} role="status" aria-live="polite" aria-label={`Market event: ${info.title}`}>
+      <span className="market-event-icon">
+        <TrendGlyph up={info.tone === 'positive'} />
+      </span>
+      <div className="market-event-body">
+        <span className="market-event-label">Market event</span>
+        <p className="market-event-head">
+          <strong>{info.title}</strong> <span className="market-event-blurb">{blurb}</span>
+        </p>
+        <p className="market-event-effect">{event.text}</p>
+      </div>
+      <button
+        className="icon-btn market-event-close"
+        onClick={() => {
+          setDismissed(key);
+          onDismiss?.();
+        }}
+        aria-label="Dismiss market event"
+      >
+        ✕
+      </button>
+    </aside>
+  );
+}
