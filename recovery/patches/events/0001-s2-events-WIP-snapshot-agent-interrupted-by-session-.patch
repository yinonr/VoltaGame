+const MARKET_SALT = 0x6d6b7400;
+
+/** Throwaway generator for one decision, derived from the seed and the turn. Never touches `s.rng`. */
+function drawFor(seed: number, turn: number): Rng {
+  return new Rng(deriveSeed(seed, MARKET_SALT + turn));
+}
+
+/** Global turn of the first event: a seed-chosen turn of round 4. */
+export function firstEventTurn(seed: number, players: number): number {
+  return (FIRST_EVENT_ROUND - 1) * players + 1 + drawFor(seed, 0).int(players);
+}
+
+/** The event the seed calls for on `turn` (a coin flip), before the relevance check in pickEvent. */
+export function seededEventType(seed: number, turn: number): MarketEventType {
+  return drawFor(seed, turn).int(2) === 0 ? 'creditCrunch' : 'computeBoom';
+}
+
+/** Turns between the event that fired on `turn` and the next one: 2–3 rounds, chosen by the seed. */
+export function eventGap(seed: number, turn: number, players: number): number {
+  const r = drawFor(seed, turn);
+  r.next(); // the first draw is the coin flip in seededEventType
+  return MIN_GAP_ROUNDS * players + r.int((MAX_GAP_ROUNDS - MIN_GAP_ROUNDS) * players + 1);
+}
+
+/**
+ * Which event fires on `turn`. Credit Crunch only bites leveraged companies, so with no financed
+ * factory on the board the boom fires instead and every scheduled event does something.
+ */
+function pickEvent(s: GameState, turn: number): MarketEventType {
+  const wanted = seededEventType(s.seed, turn);
+  return wanted === 'creditCrunch' && !s.buildings.some((b) => isFinanced(b)) ? 'computeBoom' : wanted;
+}
+
+/** "Helixa Bio's" / "Ambulo Robotics'" (an all-caps custom name such as "AWS" keeps "'s"). */
+function possessive(name: string): string {
+  return /s$/.test(name) ? `${name}'` : `${name}'s`;
+}
+
+function listNames(names: string[]): string {
+  if (names.length <= 1) return names.join('');
+  return `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
+}
+
+/**
+ * Credit Crunch: each outstanding financed factory costs its owner 1 Capital (paid to the market)
+ * to keep its terms. An owner with no Capital is never forced to pay: that factory's commitment
+ * grows by 1 instead, up to FINANCING_MAX_COMMITMENT (already at the ceiling: no effect).
+ * Fully owned factories are untouched. Returns the one-line summary for the banner.
+ */
+function creditCrunch(s: GameState): string {
+  const paid = s.players.map(() => 0);
+  const grew: number[][] = s.players.map(() => []);
+  const capped = s.players.map(() => 0);
+  s.buildings.forEach((b, v) => {
+    if (!b || !isFinanced(b)) return;
+    const owner = b.owner;
+    if (s.players[owner].resources.capital >= 1) {
+      pay(s, owner, bundle({ capital: 1 }));
+      paid[owner]++;
+    } else if (b.financed! < FINANCING_MAX_COMMITMENT) {
+      const financed = b.financed! + 1;
+      s.buildings[v] = { ...b, financed }; // a new Building: they are shared between states
+      grew[owner].push(financed);
+    } else {
+      capped[owner]++;
+    }
+  });
+
+  const parts: string[] = [];
+  s.players.forEach((_, i) => {
+    const name = nameOf(s, i);
+    if (paid[i] > 0) {
+      addLog(s, 'event', i, `${name} paid ${paid[i]} Capital to keep its financing terms.`);
+      parts.push(`${name} paid ${paid[i]} Capital`);
+    }
+    if (grew[i].length > 0) {
+      const units = listNames(grew[i].map(String));
+      const what = grew[i].length === 1 ? 'commitment' : 'commitments';
+      addLog(s, 'event', i, `${possessive(name)} ${what} grew to ${units} units.`);
+      parts.push(`${possessive(name)} ${what} grew to ${units} units`);
+    }
+    if (capped[i] > 0) {
+      addLog(s, 'event', i, `${possessive(name)} commitment is already at the ${FINANCING_MAX_COMMITMENT}-unit ceiling: no change.`);
+      parts.push(`${possessive(name)} commitment stays at the ${FINANCING_MAX_COMMITMENT}-unit ceiling`);
+    }
+  });
+  return `${parts.join('; ')}.`;
+}
+
+/**
+ * Compute Boom: every company collects 1 GPU from the market. The familiar shortage rule
+ * applies: if the market cannot pay everyone, nobody collects (every company is owed, so the
+ * sole-claimant exception never arises). Returns the one-line summary for the banner.
+ */
+function computeBoom(s: GameState): string {
+  const paysAll = s.bank.gpu >= s.players.length;
+  if (paysAll) s.players.forEach((p) => gainFromBank(s, p.id, bundle({ gpu: 1 })));
+  const text = paysAll ? 'Every company collects 1 GPU from the market.' : 'The market is short of GPUs: nobody collects.';
+  addLog(s, 'event', null, text);
+  return text;
+}
 
 /**
  * Called by the reducer at the start of every turn (END_TURN, after the new current player is set,
  * before the victory check). `s` is already cloned. Must be a no-op unless rules.marketEvents is on,
  * and must not consume the game RNG (`s.rng`), so enabling events never changes the dice.
+ *
+ * `s.market` is shared with the previous state by the shallow clone, so it is always replaced,
+ * never edited. Neither event changes anyone's Compute Points.
  */
-export function applyMarketEvents(_s: GameState): void {}
+export function applyMarketEvents(s: GameState): void {
+  if (!rulesOf(s).marketEvents) return;
+  const players = s.players.length;
+  if (!s.market) {
+    // Lazy start (also covers a save made before the rule existed): round 4 at the earliest.
+    const first = firstEventTurn(s.seed, players);
+    s.market = { nextEventTurn: s.turn < first ? first : s.turn + eventGap(s.seed, s.turn, players), last: null };
+  }
+  if (s.turn < s.market.nextEventTurn) return;
+
+  const type = pickEvent(s, s.turn);
+  const info = MARKET_EVENT_INFO[type];
+  addLog(s, 'event', null, `Market event — ${info.title}: ${info.blurb}`);
+  const text = type === 'creditCrunch' ? creditCrunch(s) : computeBoom(s);
+  const last: MarketEvent = { type, turn: s.turn, text };
+  s.market = { nextEventTurn: s.turn + eventGap(s.seed, s.turn, players), last };
+}
+
+/** The last market event if it fired within the current round (what the UI banner shows), else null. */
+export function recentMarketEvent(state: GameState): MarketEvent | null {
+  const last = state.market?.last;
+  if (!last || !rulesOf(state).marketEvents) return null;
+  return state.turn - last.turn < state.players.length ? last : null;
+}
