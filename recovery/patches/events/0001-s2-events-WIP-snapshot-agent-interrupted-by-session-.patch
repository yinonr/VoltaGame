 /* events.css — owned by the events work stream. Loaded after styles.css. */
+
+/* ---------- Market event card (MarketEventBanner, experimental rules.marketEvents) ----------
+   Floats over the top of its positioned parent: below the instruction pill in the desktop board
+   column, at the top of the board area on phones. Never blocks the board beyond its own box. */
+.market-event {
+  --tone: var(--accent);
+  position: absolute;
+  top: 52px;
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 3;
+  width: min(440px, calc(100% - 16px));
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 10px 8px 10px 12px;
+  border-radius: 12px;
+  border: 1px solid color-mix(in srgb, var(--tone) 45%, var(--border-strong));
+  border-left: 3px solid var(--tone);
+  background: rgba(8, 13, 28, 0.93);
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 22px color-mix(in srgb, var(--tone) 14%, transparent);
+  backdrop-filter: blur(8px);
+  animation: marketEventIn 0.32s ease;
+}
+.market-event.negative {
+  --tone: var(--warn);
+}
+.market-event.positive {
+  --tone: var(--ok);
+}
+
+.market-event-icon {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  margin-top: 2px;
+  border-radius: 8px;
+  color: var(--tone);
+  background: color-mix(in srgb, var(--tone) 14%, transparent);
+  border: 1px solid color-mix(in srgb, var(--tone) 40%, transparent);
+}
+
+.market-event-body {
+  flex: 1;
+  min-width: 0;
+  display: grid;
+  gap: 2px;
+}
+.market-event-label {
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--tone);
+}
+.market-event-head,
+.market-event-effect {
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+.market-event-head {
+  font-size: 13px;
+  line-height: 1.3;
+}
+.market-event-head strong {
+  font-family: var(--display);
+  font-size: 14px;
+  color: var(--text);
+}
+.market-event-blurb {
+  color: var(--muted);
+}
+.market-event-effect {
+  font-size: 12.5px;
+  line-height: 1.35;
+  color: #cbd5e1;
+}
+
+.market-event-close {
+  flex: none;
+  width: 28px;
+  height: 28px;
+  font-size: 12px;
+  color: var(--muted);
+}
+.market-event-close:hover {
+  color: var(--text);
+}
+
+@keyframes marketEventIn {
+  from {
+    opacity: 0;
+    transform: translate(-50%, -6px);
+  }
+  to {
+    opacity: 1;
+    transform: translate(-50%, 0);
+  }
+}
+
+/* Phones: top of the board area (the instruction strip sits above it), bigger tap target. */
+.m-board .market-event {
+  top: 8px;
+  padding: 8px 6px 8px 10px;
+}
+.m-board .market-event-close {
+  width: 36px;
+  height: 36px;
+}
+.m-board .market-event-head {
+  font-size: 12.5px;
+}
+.m-board .market-event-effect {
+  font-size: 12px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .market-event {
+    animation: none;
+  }
+}
