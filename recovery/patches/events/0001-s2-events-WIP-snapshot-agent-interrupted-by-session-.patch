+describe('market events: state handling', () => {
+  it('never mutate the input state, its Buildings or its market record', () => {
+    for (const type of ['creditCrunch', 'computeBoom'] as const) {
+      let s = financed(primed(11, type), 10, 2, 4);
+      s = { ...s, market: { nextEventTurn: s.market!.nextEventTurn, last: { type: 'computeBoom', turn: 1, text: 'old' } } };
+      const snapshot = structuredClone(s);
+      const after = applyAction(deepFreeze(s), END_TURN);
+      expect(s).toEqual(snapshot);
+      expect(after.market).not.toBe(s.market);
+      expect(after.market!.last!.turn).toBe(s.turn + 1);
+    }
+  });
+
+  it('shows the last event for one round only', () => {
+    const s = applyAction(primed(3, 'computeBoom'), END_TURN);
+    expect(recentMarketEvent(s)).toEqual(s.market!.last);
+    expect(recentMarketEvent({ ...s, turn: s.turn + 3 })).not.toBeNull();
+    expect(recentMarketEvent({ ...s, turn: s.turn + 4 })).toBeNull();
+    expect(recentMarketEvent({ ...s, rules: undefined })).toBeNull();
+  });
+});
+
+describe('market events: full games', () => {
+  it('all-AI flagship games with events finish, conserve resources and never go negative', () => {
+    const counts: number[] = [];
+    for (const seed of [1, 2, 3, 4, 5, 6]) {
+      const { s, eventTurns } = playAI(seed, FLAGSHIP_EVENTS, undefined, (_before, after) => {
+        expect(conservation(after)).toEqual(FULL);
+        expect(noNegatives(after)).toBe(true);
+      });
+      expect(s.phase, `seed ${seed}`).toBe('gameOver');
+      expect(victoryPoints(s, s.winner!)).toBeGreaterThanOrEqual(10);
+      expect(conservation(s)).toEqual(FULL);
+      counts.push(eventTurns.length);
+    }
+    expect(Math.min(...counts)).toBeGreaterThan(0);
+  });
+
+  it('stay bounded when every company carries financed infrastructure all game', () => {
+    // Each company's first cluster becomes a financed factory: Credit Crunch is always live.
+    const leverage = (s: GameState): GameState => {
+      const buildings = s.buildings.slice();
+      for (let p = 0; p < s.players.length; p++) {
+        const v = buildings.findIndex((b) => b?.owner === p && b.kind === 'cluster');
+        buildings[v] = { owner: p, kind: 'factory', financed: 3 };
+      }
+      return { ...s, buildings };
+    };
+    const types: MarketEventType[] = [];
+    for (const seed of [7, 8, 9, 10]) {
+      const played = playAI(seed, FLAGSHIP_EVENTS, leverage, (_before, after) => {
+        expect(conservation(after)).toEqual(FULL);
+        expect(noNegatives(after)).toBe(true);
+        for (const b of after.buildings) if (b?.financed !== undefined) expect(b.financed).toBeLessThanOrEqual(FINANCING_MAX_COMMITMENT);
+      });
+      expect(played.s.phase, `seed ${seed}`).toBe('gameOver');
+      types.push(...played.types);
+    }
+    expect(types).toContain('creditCrunch');
+    expect(types).toContain('computeBoom');
+  });
+});
