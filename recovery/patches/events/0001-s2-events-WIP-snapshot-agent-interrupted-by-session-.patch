+import { describe, expect, it } from 'vitest';
+import { decideAIAction } from '../ai';
+import { FINANCING_MAX_COMMITMENT, bundle } from '../constants';
+import { MARKET_EVENT_INFO, applyMarketEvents, eventGap, firstEventTurn, recentMarketEvent, seededEventType } from '../events';
+import { applyAction, createGame, disruptionVictims, getActingPlayer } from '../game';
+import { legalSetupClusterVertices } from '../rules';
+import { victoryPoints } from '../scoring';
+import type { Action, GameState, MarketEventType, ResourceBundle, RuleOptions } from '../types';
+import { RESOURCES } from '../types';
+import { ALL_AI, blankGame, conservation, place, setHand } from './helpers';
+
+const EVENTS_ON: RuleOptions = { financing: true, fullStack: false, marketEvents: true };
+const FLAGSHIP_EVENTS: Partial<RuleOptions> = { financing: true, fullStack: true, marketEvents: true };
+const FULL = bundle({ power: 19, networking: 19, land: 19, capital: 19, gpu: 19 });
+const END_TURN: Action = { type: 'END_TURN' };
+
+function deepFreeze<T>(o: T): T {
+  if (o && typeof o === 'object' && !Object.isFrozen(o)) {
+    Object.freeze(o);
+    for (const v of Object.values(o)) deepFreeze(v);
+  }
+  return o;
+}
+
+/** A financed AI Factory written directly (the financing engine is not needed to test events). */
+function financed(s: GameState, vertex: number, owner: number, units: number): GameState {
+  const buildings = s.buildings.slice();
+  buildings[vertex] = { owner, kind: 'factory', financed: units };
+  return { ...s, buildings };
+}
+
+/** First turn at or after `from` on which the seed calls for `type`. */
+function turnFor(seed: number, type: MarketEventType, from = 20): number {
+  for (let t = from; ; t++) if (seededEventType(seed, t) === type) return t;
+}
+
+/** Main phase of the turn just before a scheduled event that the seed resolves as `type`. */
+function primed(seed: number, type: MarketEventType): GameState {
+  const s = blankGame(seed);
+  const t = turnFor(s.seed, type);
+  return { ...s, rules: { ...EVENTS_ON }, turn: t - 1, market: { nextEventTurn: t, last: null } };
+}
+
+function eventLines(s: GameState, sinceLogId: number): string[] {
+  return s.log.filter((l) => l.kind === 'event' && l.id >= sinceLogId).map((l) => l.text);
+}
+
+function noNegatives(s: GameState): boolean {
+  return [s.bank, ...s.players.map((p) => p.resources)].every((b) => RESOURCES.every((r) => b[r] >= 0));
+}
+
+interface Played {
+  s: GameState;
+  rolls: number[];
+  /** Turns on which a market event fired. */
+  eventTurns: number[];
+  types: MarketEventType[];
+}
+
+/** An all-AI game. `check` sees every END_TURN transition (before, after). */
+function playAI(seed: number, rules: Partial<RuleOptions> | undefined, prep?: (s: GameState) => GameState, check?: (before: GameState, after: GameState) => void): Played {
+  let s = createGame({ seed, seats: ALL_AI, rules });
+  if (prep) s = prep(s);
+  const rolls: number[] = [];
+  const eventTurns: number[] = [];
+  const types: MarketEventType[] = [];
+  for (let steps = 0; s.phase !== 'gameOver' && steps < 6000; steps++) {
+    const action = decideAIAction(s, getActingPlayer(s)!);
+    const next = applyAction(s, action);
+    if (action.type === 'ROLL') rolls.push(next.lastRoll!.total);
+    if (action.type === 'END_TURN') {
+      check?.(s, next);
+      const last = next.market?.last;
+      if (last && last !== s.market?.last) {
+        eventTurns.push(last.turn);
+        types.push(last.type);
+      }
+    }
+    s = next;
+  }
+  return { s, rolls, eventTurns, types };
+}
+
+describe('market events: gating', () => {
+  it('are a strict no-op when the rule is off or absent, even on an event turn', () => {
+    const base = primed(3, 'computeBoom');
+    const variants: GameState[] = [
+      { ...base, rules: { financing: false, fullStack: false, marketEvents: false } },
+      { ...base, rules: { financing: true, fullStack: true, marketEvents: false } },
+      { ...base, rules: undefined, market: undefined }, // an old save
+      { ...financed(base, 10, 1, 3), rules: { financing: true, fullStack: true, marketEvents: false }, turn: base.turn + 1 },
+    ];
+    for (const v of variants) {
+      const copy = structuredClone(v);
+      applyMarketEvents(copy);
+      expect(copy).toEqual(v);
+    }
+  });
+
+  it('never touch Classic seeded AI games', () => {
+    for (const seed of [4, 21]) {
+      const { s } = playAI(seed, undefined, undefined, (_before, after) => {
+        expect(after.market).toBeUndefined();
+        const copy = structuredClone(after);
+        applyMarketEvents(copy);
+        expect(copy).toEqual(after);
+      });
+      expect(s.phase).toBe('gameOver');
+      expect(s.log.some((l) => l.kind === 'event')).toBe(false);
+    }
+  });
+});
+
+describe('market events: timing', () => {
+  it('first fire in round 4 and then every 2–3 rounds, for 2–4 companies', () => {
+    const firsts = new Set<number>();
+    for (let seed = 1; seed <= 300; seed++) {
+      for (const n of [2, 3, 4]) {
+        const first = firstEventTurn(seed, n);
+        expect(first).toBeGreaterThan(3 * n);
+        expect(first).toBeLessThanOrEqual(4 * n);
+        expect(firstEventTurn(seed, n)).toBe(first); // deterministic
+        if (n === 4) firsts.add(first);
+        for (const turn of [first, 40, 77]) {
+          const gap = eventGap(seed, turn, n);
+          expect(gap).toBeGreaterThanOrEqual(2 * n);
+          expect(gap).toBeLessThanOrEqual(3 * n);
+        }
+      }
+    }
+    expect(firsts.size).toBe(4); // every seat of round 4 can open the event track
+  });
+
+  it('pick both events from the seed, roughly evenly', () => {
+    let crunch = 0;
+    for (let t = 1; t <= 1000; t++) if (seededEventType(77, t) === 'creditCrunch') crunch++;
+    expect(crunch).toBeGreaterThan(400);
+    expect(crunch).toBeLessThan(600);
+  });
+
+  it('fire on the seeded schedule in AI games: deterministic and infrequent', () => {
+    for (const seed of [2, 9, 13]) {
+      const a = playAI(seed, FLAGSHIP_EVENTS);
+      const b = playAI(seed, FLAGSHIP_EVENTS);
+      expect(b.eventTurns).toEqual(a.eventTurns);
+      expect(b.s.log.map((l) => l.text)).toEqual(a.s.log.map((l) => l.text));
+      const n = a.s.players.length;
+      // The schedule depends only on the seed and the turn number.
+      const expected: number[] = [];
+      for (let t = firstEventTurn(a.s.seed, n); t <= a.s.turn; t += eventGap(a.s.seed, t, n)) expected.push(t);
+      expect(a.eventTurns).toEqual(expected);
+      expect(a.eventTurns.length).toBeGreaterThan(0);
+      expect(a.eventTurns.length).toBeLessThanOrEqual(Math.ceil(a.s.turn / (2 * n)));
+    }
+  });
+
+  it('start lazily: a mid-game save with the rule on schedules ahead and does not fire at once', () => {
+    const s = { ...blankGame(8), rules: { ...EVENTS_ON }, turn: 30 };
+    const after = applyAction(s, END_TURN);
+    expect(after.market!.last).toBeNull();
+    expect(after.market!.nextEventTurn).toBeGreaterThanOrEqual(31 + 8);
+    const early = applyAction({ ...s, turn: 1 }, END_TURN);
+    expect(early.market).toEqual({ nextEventTurn: firstEventTurn(s.seed, 4), last: null });
+  });
+});
+
+describe('market events: dice and RNG', () => {
+  it('never consume the game RNG: END_TURN leaves it untouched and matches the events-off reducer', () => {
+    let fired = 0;
+    for (const seed of [5, 17]) {
+      const { eventTurns } = playAI(seed, FLAGSHIP_EVENTS, undefined, (before, after) => {
+        expect(after.rng).toBe(before.rng);
+        const off = applyAction({ ...before, rules: { ...before.rules!, marketEvents: false } }, END_TURN);
+        expect(after.rng).toBe(off.rng);
+        expect([after.turn, after.currentPlayer, after.phase]).toEqual([off.turn, off.currentPlayer, off.phase]);
+      });
+      fired += eventTurns.length;
+    }
+    expect(fired).toBeGreaterThan(0);
+  });
+
+  it('leave the dice identical for the same seed (AI games: every roll before the first event)', () => {
+    for (const seed of [1, 6, 30]) {
+      const on = playAI(seed, FLAGSHIP_EVENTS);
+      const off = playAI(seed, { financing: true, fullStack: true, marketEvents: false });
+      // One roll per turn: the rolls of turns 1..E, where the first event fired at the start of turn E.
+      const upTo = on.eventTurns[0];
+      expect(upTo).toBeGreaterThan(12);
+      expect(on.rolls.slice(0, upTo)).toEqual(off.rolls.slice(0, upTo));
+      // Later the games may part ways: events change hands, so the AI builds, plays cards and
+      // steals differently (a steal is an RNG draw). The dice stream itself is never touched.
+    }
+  });
+
+  it('leave the whole dice sequence identical when both games take the same actions', () => {
+    // Roll-and-pass with financed factories on the board; the disruption always moves to an
+    // empty hex, so the only RNG draws are dice. Events fire (and change hands) all game long.
+    const play = (marketEvents: boolean) => {
+      let s = blankGame(12);
+      s = { ...s, rules: { financing: true, fullStack: false, marketEvents } };
+      const occupied = new Set<number>();
+      // [owner, committed units]; 0 = a plain cluster. Sites follow the distance rule.
+      [[0, 1], [1, 2], [2, 1], [3, 0]].forEach(([owner, units]) => {
+        const v = legalSetupClusterVertices(s)[0];
+        s = units > 0 ? financed(s, v, owner, units) : place(s, v, owner, 'cluster');
+        for (const t of s.board.vertices[v].tileIds) occupied.add(t);
+      });
+      const empty = s.board.tiles.map((t) => t.id).filter((t) => !occupied.has(t));
+      const rolls: number[] = [];
+      let events = 0;
+      for (let i = 0; i < 120; i++) {
+        s = applyAction(s, END_TURN);
+        if (s.market?.last?.turn === s.turn) events++;
+        s = applyAction(s, { type: 'ROLL' });
+        rolls.push(s.lastRoll!.total);
+        while (s.phase === 'discard') {
+          const p = getActingPlayer(s)!;
+          s = applyAction(s, { type: 'DISCARD', resources: discardPick(s.players[p].resources, s.pendingDiscards[p]) });
+        }
+        if (s.phase === 'moveDisruption') {
+          const tile = empty.find((t) => t !== s.disruptionTile)!;
+          expect(disruptionVictims(s, tile, s.currentPlayer)).toEqual([]);
+          s = applyAction(s, { type: 'MOVE_DISRUPTION', tile, victim: null });
+        }
+      }
+      return { s, rolls, events };
+    };
+    const on = play(true);
+    const off = play(false);
+    expect(on.events).toBeGreaterThanOrEqual(8);
+    expect(off.events).toBe(0);
+    expect(on.rolls).toEqual(off.rolls);
+    expect(on.s.rng).toBe(off.s.rng);
+    expect(on.s.players.map((p) => p.resources)).not.toEqual(off.s.players.map((p) => p.resources));
+    expect(conservation(on.s)).toEqual(FULL);
+  });
+});
+
+function discardPick(hand: ResourceBundle, n: number): ResourceBundle {
+  const out = bundle();
+  for (let left = n; left > 0; left--) {
+    const r = RESOURCES.reduce((best, x) => (hand[x] - out[x] > hand[best] - out[best] ? x : best), RESOURCES[0]);
+    out[r]++;
+  }
+  return out;
+}
+
