+    s = financed(s, 10, 1, 3);
+    s = setHand(s, 1, { capital: 2, land: 1 });
+    s = financed(s, 20, 2, 3);
+    s = setHand(s, 2, { power: 2, gpu: 1 });
+    s = financed(s, 30, 3, FINANCING_MAX_COMMITMENT);
+    const t = s.turn + 1;
+    const after = applyAction(deepFreeze(s), END_TURN);
+
+    expect(after.turn).toBe(t);
+    expect(after.players[1].resources).toEqual(bundle({ capital: 1, land: 1 }));
+    expect(after.bank.capital).toBe(s.bank.capital + 1);
+    expect(after.buildings[10]).toBe(s.buildings[10]); // paid: same terms, same object
+    expect(after.buildings[20]).toEqual({ owner: 2, kind: 'factory', financed: 4 });
+    expect(s.buildings[20]!.financed).toBe(3);
+    expect(after.players[2].resources).toEqual(s.players[2].resources); // never forced to pay
+    expect(after.buildings[30]).toBe(s.buildings[30]);
+    expect(after.buildings[0]).toBe(s.buildings[0]);
+    expect(after.players[0].resources).toEqual(s.players[0].resources);
+
+    expect(eventLines(after, s.nextLogId)).toEqual([
+      'Market event — Credit Crunch: lenders tighten terms on financed infrastructure.',
+      'Helixa Bio paid 1 Capital to keep its financing terms.',
+      "Ambulo Robotics' commitment grew to 4 units.",
+      `Stacksmith's commitment is already at the ${FINANCING_MAX_COMMITMENT}-unit ceiling: no change.`,
+    ]);
+    expect(after.market!.last).toEqual({
+      type: 'creditCrunch',
+      turn: t,
+      text: `Helixa Bio paid 1 Capital; Ambulo Robotics' commitment grew to 4 units; Stacksmith's commitment stays at the ${FINANCING_MAX_COMMITMENT}-unit ceiling.`,
+    });
+    expect(after.market!.nextEventTurn).toBe(t + eventGap(s.seed, t, 4));
+    expect(conservation(after)).toEqual(FULL);
+    for (let p = 0; p < 4; p++) expect(victoryPoints(after, p)).toBe(victoryPoints(s, p)); // never moves CP
+  });
+
+  it('charges per financed factory: one Capital covers one, the other is extended', () => {
+    let s = primed(6, 'creditCrunch');
+    s = financed(s, 10, 1, 3);
+    s = financed(s, 20, 1, 4);
+    s = setHand(s, 1, { capital: 1 });
+    s = financed(s, 30, 2, 3);
+    s = financed(s, 40, 2, 4);
+    const after = applyAction(deepFreeze(s), END_TURN);
+    expect(after.players[1].resources.capital).toBe(0);
+    expect(after.buildings[10]).toBe(s.buildings[10]);
+    expect(after.buildings[20]).toEqual({ owner: 1, kind: 'factory', financed: 5 });
+    expect([after.buildings[30]!.financed, after.buildings[40]!.financed]).toEqual([4, 5]);
+    expect(eventLines(after, s.nextLogId).slice(1)).toEqual([
+      'Helixa Bio paid 1 Capital to keep its financing terms.',
