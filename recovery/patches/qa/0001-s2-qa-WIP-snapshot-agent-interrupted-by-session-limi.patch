+import { it } from 'vitest';
+import { decideAIAction } from '../ai';
+import { applyAction, getActingPlayer } from '../game';
+import type { Action, GameState } from '../types';
+import { QA_CONFIGS, assertJsonSafe, checkLongestNetwork, checkState, checkTransition, deepFreeze, newGame } from './qa-checks';
+
+it('timing probe', () => {
+  const cfg = QA_CONFIGS[0];
+  const states: GameState[] = [];
+  const actions: Action[] = [];
+  for (const seed of [1, 2, 3]) {
+    let s = deepFreeze(newGame(cfg, seed));
+    while (s.phase !== 'gameOver') {
+      const a = decideAIAction(s, getActingPlayer(s)!);
+      states.push(s);
+      actions.push(a);
+      s = deepFreeze(applyAction(s, a));
+    }
+  }
+  const time = (label: string, f: (i: number) => void) => {
+    const t0 = performance.now();
+    for (let rep = 0; rep < 3; rep++) for (let i = 0; i < states.length; i++) f(i);
+    console.log(label.padEnd(14), ((performance.now() - t0) / 3 / states.length * 1000).toFixed(1), 'us/step');
+  };
+  time('ai', (i) => decideAIAction(states[i], getActingPlayer(states[i])!));
+  time('apply', (i) => applyAction(states[i], actions[i]));
+  time('checkState', (i) => checkState(states[i]));
+  time('transition', (i) => i + 1 < states.length && states[i + 1].seed === states[i].seed && checkTransition(states[i], actions[i], states[i + 1]));
+  time('longest', (i) => checkLongestNetwork(states[i]));
+  time('json walk', (i) => assertJsonSafe(states[i]));
+  time('stringify', (i) => JSON.stringify(states[i]));
+  time('freeze new', (i) => deepFreeze(applyAction(states[i], actions[i])));
+}, 600000);
